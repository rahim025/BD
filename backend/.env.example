# Port du serveur
PORT=3000

# --- Clés pour découper le scénario (essayées dans l'ordre) ---

# Gemini (gratuit) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (gratuit, utilisé en secours si Gemini échoue) : https://console.groq.com/keys
GROQ_API_KEY=

# --- Génération d'image ---

# Pollinations.ai est utilisé en premier, gratuit et sans clé, rien à renseigner.

# Hugging Face (gratuit, utilisé en secours si Pollinations échoue)
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
